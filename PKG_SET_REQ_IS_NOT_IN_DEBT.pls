create or replace PACKAGE BODY PKG_SET_REQ_IS_NOT_IN_DEBT IS
  TYPE T_SERVICE_REQ_IDS IS TABLE OF HIS_SERVICE_REQ.ID%TYPE;

  PROCEDURE PRO_EXECUTE AS
    V_TIME_NOW			NUMBER;
	V_BHYT_ID			HIS_PATIENT_TYPE.ID%TYPE;
	V_CHECK_BHYT		NUMBER;
	V_CHECK				NUMBER;
	V_CHECK_RESULT		NUMBER;
	V_CHECK_EXTRA_MESSAGE		VARCHAR2(500);
    MIN_START_DURATION NUMBER := 0;
    LOGINNAME		HIS_SERVICE_REQ.EXECUTE_LOGINNAME%TYPE := 'ssss';
    START_TIME		HIS_SERVICE_REQ.START_TIME%TYPE := 20240423000000;

    V_REQ_ID_NOT_IN_DEBT  T_SERVICE_REQ_IDS := T_SERVICE_REQ_IDS();
    V_REQ_ID_IN_DEBT      T_SERVICE_REQ_IDS := T_SERVICE_REQ_IDS();
  BEGIN
    --1. Lay gio hien tai (sysdate)
    SELECT TO_NUMBER(TO_CHAR(SYSDATE, 'YYYYMMDDHH24MISS')) INTO V_TIME_NOW FROM DUAL;
	--Lui 2s tranh th insert trong 1% giay
    V_TIME_NOW := V_TIME_NOW - 2;

	--Mac dinh = 0
	V_BHYT_ID := 0;
	V_CHECK_BHYT := 0;

	--Lay id cua doi tuong BHYT
	SELECT COUNT(1) INTO V_CHECK FROM HIS_CONFIG WHERE KEY = 'MOS.HIS_PATIENT_TYPE.PATIENT_TYPE_CODE.BHYT' AND VALUE IS NOT NULL;
	IF V_CHECK > 0 THEN
		SELECT COUNT(1) INTO V_CHECK FROM HIS_PATIENT_TYPE P 
		WHERE EXISTS (SELECT 1 FROM HIS_CONFIG 
			WHERE KEY = 'MOS.HIS_PATIENT_TYPE.PATIENT_TYPE_CODE.BHYT' AND CAST(VALUE AS VARCHAR2(6)) = P.PATIENT_TYPE_CODE);

		IF V_CHECK > 0 THEN
			SELECT P.ID INTO V_BHYT_ID
			FROM HIS_PATIENT_TYPE P 
			WHERE EXISTS (SELECT 1 FROM HIS_CONFIG WHERE KEY = 'MOS.HIS_PATIENT_TYPE.PATIENT_TYPE_CODE.BHYT' AND CAST(VALUE AS VARCHAR2(6)) = P.PATIENT_TYPE_CODE)
			ORDER BY ID DESC 
			FETCH FIRST ROWS ONLY;
		END IF;
	END IF;

	--Lay gia tri cua cau hinh "khong kiem tra voi BN BHYT"
	SELECT COUNT(1) INTO V_CHECK FROM HIS_CONFIG WHERE KEY = 'MOS.HIS_SERVICE_REQ.NOT_REQUIRE_FEE_FOR_BHYT' AND (VALUE IS NOT NULL OR DEFAULT_VALUE IS NOT NULL);

	IF V_CHECK > 0 THEN
		SELECT NVL(CAST(VALUE AS VARCHAR2(1)), DEFAULT_VALUE) INTO V_CHECK_BHYT FROM HIS_CONFIG WHERE  KEY = 'MOS.HIS_SERVICE_REQ.NOT_REQUIRE_FEE_FOR_BHYT';
		IF V_CHECK_BHYT <> 1 THEN
			V_CHECK_BHYT := 0;
		END IF;
	END IF;

    --2. Lay tat ca du lieu trong HIS_SERE_CHANGE_DEBT co create_time < gio hien tai  
    --3. Thuc hien vong lap xu ly voi tung service_req_id 
    FOR ITEM IN (SELECT DISTINCT (SERVICE_REQ_ID) FROM HIS_SERE_CHANGE_DEBT WHERE CREATE_TIME < V_TIME_NOW) LOOP
      PKG_START_SERVICE_REQ.PRO_START(V_CHECK_RESULT, V_CHECK_EXTRA_MESSAGE, ITEM.SERVICE_REQ_ID, V_CHECK_BHYT, V_BHYT_ID,MIN_START_DURATION,LOGINNAME,START_TIME);

      IF V_CHECK_RESULT = 1 THEN
        --DUA SERVICE_REQ_ID VAO <<danh sach 1>>
        V_REQ_ID_NOT_IN_DEBT.EXTEND;
        V_REQ_ID_NOT_IN_DEBT(V_REQ_ID_NOT_IN_DEBT.LAST) := ITEM.SERVICE_REQ_ID;
      ELSE
        --DUA SERVICE_REQ_ID VAO <<danh sach 2>>
        V_REQ_ID_IN_DEBT.EXTEND;
        V_REQ_ID_IN_DEBT(V_REQ_ID_IN_DEBT.LAST) := ITEM.SERVICE_REQ_ID;
      END IF;
    END LOOP;

    --4. Ket thuc vong lap, update cho cac danh sach
    IF V_REQ_ID_NOT_IN_DEBT.COUNT > 0 THEN
      FORALL I IN V_REQ_ID_NOT_IN_DEBT.FIRST .. V_REQ_ID_NOT_IN_DEBT.LAST
        UPDATE HIS_SERVICE_REQ
           SET IS_NOT_IN_DEBT = 1
         WHERE ID = V_REQ_ID_NOT_IN_DEBT(I)
           AND IS_NOT_IN_DEBT IS NULL;
      COMMIT;
    END IF;

    IF V_REQ_ID_IN_DEBT.COUNT > 0 THEN
      FORALL I IN V_REQ_ID_IN_DEBT.FIRST .. V_REQ_ID_IN_DEBT.LAST
        UPDATE HIS_SERVICE_REQ
           SET IS_NOT_IN_DEBT = NULL
         WHERE ID = V_REQ_ID_IN_DEBT(I)
           AND IS_NOT_IN_DEBT = 1;
      COMMIT;
    END IF;

    --5. Xoa cac du lieu vua xu ly
    DELETE FROM HIS_SERE_CHANGE_DEBT WHERE CREATE_TIME < V_TIME_NOW;
    COMMIT;
  EXCEPTION
    WHEN OTHERS THEN
      PRO_INSERT_DB_LOG('PKG_SET_REQ_IS_NOT_IN_DEBT',
                        SQLCODE || ':' || SQLERRM || ':' || ' V_TIME_NOW:' || V_TIME_NOW,
                        'ERROR OTHERS PRO_EXECUTE');
  END PRO_EXECUTE;
END PKG_SET_REQ_IS_NOT_IN_DEBT;